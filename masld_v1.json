{
  "name": "MASLD",
  "remarks": [
    "Synthetic MASLD module for testing MASLD queries and automated coding. Built for PLHI Lab testing; not clinically validated."
  ],
  "gmf_version": 2,
  "states": {
    "Initial": {
      "type": "Initial",
      "remarks": [
        "MASLD (metabolic dysfunction-associated steatotic liver disease) module for synthetic testing.",
        "Adults with cardiometabolic risk factors (T2DM, obesity, hypertension) get a higher chance of MASLD.",
        "Each patient is assigned a fibrosis band (low / indeterminate / high / cirrhosis). Lab ranges for AST, ALT and platelets",
        "are set so the FIB-4 score usually falls in the matching band, giving test cases for FIB-4 risk stratification.",
        "Prevalence and stage splits are rough approximations for testing, not calibrated epidemiology."
      ],
      "direct_transition": "Wait_Until_Adult"
    },
    "Wait_Until_Adult": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 25,
        "unit": "years"
      },
      "direct_transition": "Onset_Delay"
    },
    "Onset_Delay": {
      "type": "Delay",
      "range": {
        "low": 0,
        "high": 30,
        "unit": "years"
      },
      "direct_transition": "Risk_Check"
    },
    "Risk_Check": {
      "type": "Simple",
      "complex_transition": [
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "diabetes",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "obesity",
                "operator": "is not nil"
              },
              {
                "condition_type": "Active Condition",
                "codes": [
                  {
                    "system": "SNOMED-CT",
                    "code": "59621000",
                    "display": "Essential hypertension (disorder)"
                  }
                ]
              }
            ]
          },
          "distributions": [
            {
              "transition": "MASLD_Onset",
              "distribution": 0.55
            },
            {
              "transition": "Terminal",
              "distribution": 0.45
            }
          ]
        },
        {
          "distributions": [
            {
              "transition": "MASLD_Onset",
              "distribution": 0.12
            },
            {
              "transition": "Terminal",
              "distribution": 0.88
            }
          ]
        }
      ]
    },
    "MASLD_Onset": {
      "type": "ConditionOnset",
      "target_encounter": "MASLD_Diagnosis_Encounter",
      "assign_to_attribute": "masld",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "197321007",
          "display": "Steatosis of liver (disorder)"
        }
      ],
      "direct_transition": "Assign_Fibrosis_Band"
    },
    "Assign_Fibrosis_Band": {
      "type": "Simple",
      "distributed_transition": [
        {
          "transition": "Band_low",
          "distribution": 0.7
        },
        {
          "transition": "Band_indeterminate",
          "distribution": 0.15
        },
        {
          "transition": "Band_high",
          "distribution": 0.1
        },
        {
          "transition": "Band_cirrhosis",
          "distribution": 0.05
        }
      ]
    },
    "Band_low": {
      "type": "SetAttribute",
      "attribute": "masld_fibrosis_band",
      "value": "low",
      "direct_transition": "MASLD_Diagnosis_Encounter"
    },
    "Band_indeterminate": {
      "type": "SetAttribute",
      "attribute": "masld_fibrosis_band",
      "value": "indeterminate",
      "direct_transition": "MASLD_Diagnosis_Encounter"
    },
    "Band_high": {
      "type": "SetAttribute",
      "attribute": "masld_fibrosis_band",
      "value": "high",
      "direct_transition": "MASLD_Diagnosis_Encounter"
    },
    "Band_cirrhosis": {
      "type": "SetAttribute",
      "attribute": "masld_fibrosis_band",
      "value": "cirrhosis",
      "direct_transition": "MASLD_Diagnosis_Encounter"
    },
    "MASLD_Diagnosis_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "MASLD_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185347001",
          "display": "Encounter for problem (procedure)"
        }
      ],
      "direct_transition": "Abdominal_Ultrasound"
    },
    "Abdominal_Ultrasound": {
      "type": "Procedure",
      "reason": "MASLD_Onset",
