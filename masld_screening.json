{
  "name": "MASLD screening labs",
  "remarks": [
    "Companion to masld.json (shares the masld_fibrosis_band attribute). Not clinically validated."
  ],
  "gmf_version": 2,
  "states": {
    "Initial": {
      "type": "Initial",
      "remarks": [
        "Yearly FIB-4 lab loop for adults 18+ with T2DM, obesity (latest BMI >= 30 or an obesity\ncondition) or essential hypertension, whether or not they have MASLD. Each pass is a\ncheck-up encounter with AST, ALT and platelets:\n  - no MASLD  -> normal ranges (AST 15-30 U/L, ALT 15-35 U/L, platelets 180-350 10*3/uL)\n  - MASLD     -> the same band x age-group ranges masld.json uses (lab_ranges.py), read from\n                 the shared person attribute 'masld_fibrosis_band' that masld.json sets.\nIt is a separate module because a Synthea module is one state machine with no parallel\nbranches; this loop has to run alongside masld.json's own diagnosis/follow-up timeline."
      ],
      "direct_transition": "Wait_Until_18"
    },
    "Wait_Until_18": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 18,
        "unit": "years"
      },
      "direct_transition": "Wait_Until_At_Risk"
    },
    "Wait_Until_At_Risk": {
      "type": "Guard",
      "remarks": [
        "T2DM, obesity (BMI >= 30 or obesity condition) or hypertension."
      ],
      "allow": {
        "condition_type": "Or",
        "conditions": [
          {
            "condition_type": "Active Condition",
            "codes": [
              {
                "system": "SNOMED-CT",
                "code": "44054006",
                "display": "Diabetes mellitus type 2 (disorder)"
              }
            ]
          },
          {
            "condition_type": "Observation",
            "codes": [
              {
                "system": "LOINC",
                "code": "39156-5",
                "display": "Body mass index (BMI) [Ratio]"
              }
            ],
            "operator": ">=",
            "value": 30
          },
          {
            "condition_type": "Active Condition",
            "codes": [
              {
                "system": "SNOMED-CT",
                "code": "162864005",
                "display": "Body mass index 30+ - obesity (finding)"
              },
              {
                "system": "SNOMED-CT",
                "code": "408512008",
                "display": "Body mass index 40+ - severely obese (finding)"
              },
              {
                "system": "SNOMED-CT",
                "code": "414916001",
                "display": "Obesity (disorder)"
              }
            ]
          },
          {
            "condition_type": "Active Condition",
            "codes": [
              {
                "system": "SNOMED-CT",
                "code": "59621000",
                "display": "Essential hypertension (disorder)"
              }
            ]
          }
        ]
      },
      "direct_transition": "Screening_Encounter"
    },
    "Screening_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Screening_Labs"
    },
    "End_Screening_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "Screening_Delay"
    },
    "Screening_Delay": {
      "type": "Delay",
      "exact": {
        "quantity": 11,
        "unit": "months"
      },
      "direct_transition": "Wait_Until_At_Risk"
    },
    "Screening_Labs_low": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Screening_low_under50_AST",
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 50,
            "unit": "years"
          }
        },
        {
          "transition": "Screening_low_50to64_AST",
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 65,
            "unit": "years"
          }
        },
        {
          "transition": "Screening_low_65plus_AST"
        }
      ]
    },
